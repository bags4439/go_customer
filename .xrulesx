## ENTITIES (Domain Layer)

```dart
// Pure Dart — no Flutter, no Firebase, no freezed
// Use const constructors where possible
class Order {
  final String id;
  final String orderRef;
  final String buyerId;
  final String? agentId;
  final OrderStatus status;
  final bool firstPaymentMade;
  final DateTime createdAt;

  const Order({
    required this.id,
    required this.orderRef,
    required this.buyerId,
    this.agentId,
    required this.status,
    required this.firstPaymentMade,
    required this.createdAt,
  });
}

enum OrderStatus {
  open,
  agentAssigned,
  searching,
  bidPlaced,
  bidWon,
  bidLost,
  paymentPending,
  paymentReceived,
  shipping,
  arrived,
  dutyPending,
  dutyPaid,
  clearanceInProgress,
  clearanceComplete,
  repairPending,
  repairInProgress,
  repairComplete,
  delivered,
  cancelled,
  dormant,
}
```

---

## DATA MODELS (Data Layer)

```dart
// freezed + json_serializable
// Maps to/from Firestore documents
// Contains toEntity() method to convert to domain entity

@freezed
class OrderModel with _$OrderModel {
  const factory OrderModel({
    required String id,
    required String orderRef,
    required String buyerId,
    String? agentId,
    required String status,
    required bool firstPaymentMade,
    required Timestamp createdAt,
  }) = _OrderModel;

  factory OrderModel.fromJson(Map<String, dynamic> json) =>
      _$OrderModelFromJson(json);

  // Factory from Firestore document
  factory OrderModel.fromFirestore(DocumentSnapshot doc) {
    final data = doc.data() as Map<String, dynamic>;
    return OrderModel.fromJson({...data, 'id': doc.id});
  }
}

// Extension for mapping to domain entity
extension OrderModelX on OrderModel {
  Order toEntity() => Order(
    id: id,
    orderRef: orderRef,
    buyerId: buyerId,
    agentId: agentId,
    status: OrderStatus.values.firstWhere((e) => e.name == status),
    firstPaymentMade: firstPaymentMade,
    createdAt: createdAt.toDate(),
  );
}
```

