## REPOSITORY INTERFACES (Domain Layer)

```dart
// Abstract — no Firebase imports
abstract class OrderRepository {
  Stream<Either<Failure, List<Order>>> watchBuyerOrders(String buyerId);
  Future<Either<Failure, Order>> getOrder(String orderId);
  Future<Either<Failure, String>> createOrder(CreateOrderParams params);
  Future<Either<Failure, Unit>> cancelOrder(CancelOrderParams params);
  Future<Either<Failure, Unit>> updateOrderStatus(String orderId, OrderStatus status);
}
```

---

## REPOSITORY IMPLEMENTATIONS (Data Layer)

```dart
// Implements domain interface — knows about Firebase
class OrderRepositoryImpl implements OrderRepository {
  final OrderFirestoreDataSource _dataSource;

  OrderRepositoryImpl(this._dataSource);

  @override
  Stream<Either<Failure, List<Order>>> watchBuyerOrders(String buyerId) {
    return _dataSource.watchBuyerOrders(buyerId).map(
      (models) => Right(models.map((m) => m.toEntity()).toList()),
    ).handleError(
      (error) => Left(FirestoreFailure(message: error.toString())),
    );
  }
}
```

---

## USE CASES (Domain Layer)

```dart
// One use case per file
// Returns Either<Failure, T>
// No Flutter/Firebase imports

class GetActiveOrdersUseCase {
  final OrderRepository _repository;

  GetActiveOrdersUseCase(this._repository);

  Stream<Either<Failure, List<Order>>> call(String buyerId) {
    return _repository.watchBuyerOrders(buyerId);
  }
}

// For use cases with parameters, use a Params class:
class CancelOrderParams {
  final String orderId;
  final String reason;
  const CancelOrderParams({required this.orderId, required this.reason});
}
```

---

## FAILURES (Domain Layer)

```dart
// core/error/failures.dart
abstract class Failure {
  final String message;
  const Failure({required this.message});
}

class FirestoreFailure extends Failure {
  const FirestoreFailure({required super.message});
}

class AuthFailure extends Failure {
  const AuthFailure({required super.message});
}

class StorageFailure extends Failure {
  const StorageFailure({required super.message});
}

class NetworkFailure extends Failure {
  const NetworkFailure({required super.message});
}

class PaymentFailure extends Failure {
  const PaymentFailure({required super.message});
}

class ValidationFailure extends Failure {
  const ValidationFailure({required super.message});
}

class UnexpectedFailure extends Failure {
  const UnexpectedFailure({required super.message});
}
```

