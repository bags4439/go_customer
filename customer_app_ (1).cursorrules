## ENTITIES (Domain Layer)

```dart
// Pure Dart — no Flutter, no Firebase, no freezed
class Order {
  final String id;
  final String orderRef;
  final String buyerId;
  final String? agentId;
  final OrderStatus status;
  final bool firstPaymentMade;
  final DateTime createdAt;

  const Order({
    required this.id,
    required this.orderRef,
    required this.buyerId,
    this.agentId,
    required this.status,
    required this.firstPaymentMade,
    required this.createdAt,
  });
}

enum OrderStatus {
  open, agentAssigned, searching, bidPlaced, bidWon, bidLost,
  paymentPending, paymentReceived, shipping, arrived, dutyPending,
  dutyPaid, clearanceInProgress, clearanceComplete, repairPending,
  repairInProgress, repairComplete, delivered, cancelled, dormant,
}
```

---

## DATA MODELS (Data Layer)

```dart
@freezed
class OrderModel with _$OrderModel {
  const factory OrderModel({
    required String id,
    required String orderRef,
    required String buyerId,
    String? agentId,
    required String status,
    required bool firstPaymentMade,
    required Timestamp createdAt,
  }) = _OrderModel;

  factory OrderModel.fromJson(Map<String, dynamic> json) =>
      _$OrderModelFromJson(json);

  factory OrderModel.fromFirestore(DocumentSnapshot doc) {
    final data = doc.data() as Map<String, dynamic>;
    return OrderModel.fromJson({...data, 'id': doc.id});
  }
}

extension OrderModelX on OrderModel {
  Order toEntity() => Order(
    id: id,
    orderRef: orderRef,
    buyerId: buyerId,
    agentId: agentId,
    status: OrderStatus.values.firstWhere((e) => e.name == status),
    firstPaymentMade: firstPaymentMade,
    createdAt: createdAt.toDate(),
  );
}
```

---

## REPOSITORY INTERFACES (Domain Layer)

```dart
abstract class OrderRepository {
  Stream<Either<Failure, List<Order>>> watchBuyerOrders(String buyerId);
  Future<Either<Failure, Order>> getOrder(String orderId);
  Future<Either<Failure, String>> createOrder(CreateOrderParams params);
  Future<Either<Failure, Unit>> cancelOrder(CancelOrderParams params);
  Future<Either<Failure, Unit>> updateOrderStatus(String orderId, OrderStatus status);
}
```

---

## REPOSITORY IMPLEMENTATIONS (Data Layer)

```dart
class OrderRepositoryImpl implements OrderRepository {
  final OrderFirestoreDataSource _dataSource;
  OrderRepositoryImpl(this._dataSource);

  @override
  Stream<Either<Failure, List<Order>>> watchBuyerOrders(String buyerId) {
    return _dataSource.watchBuyerOrders(buyerId).map(
      (models) => Right<Failure, List<Order>>(models.map((m) => m.toEntity()).toList()),
    ).handleError(
      (error) => Left<Failure, List<Order>>(FirestoreFailure(message: error.toString())),
    );
  }
}
```

---

## USE CASES (Domain Layer)

```dart
// One use case per file — returns Either<Failure, T>
class GetActiveOrdersUseCase {
  final OrderRepository _repository;
  GetActiveOrdersUseCase(this._repository);

  Stream<Either<Failure, List<Order>>> call(String buyerId) =>
      _repository.watchBuyerOrders(buyerId);
}

class CancelOrderParams {
  final String orderId;
  final String reason;
  const CancelOrderParams({required this.orderId, required this.reason});
}
```

---

## FAILURES (Domain Layer)

```dart
abstract class Failure {
  final String message;
  const Failure({required this.message});
}
class FirestoreFailure extends Failure {
  const FirestoreFailure({required super.message});
}
class AuthFailure extends Failure {
  const AuthFailure({required super.message});
}
class StorageFailure extends Failure {
  const StorageFailure({required super.message});
}
class NetworkFailure extends Failure {
  const NetworkFailure({required super.message});
}
class PaymentFailure extends Failure {
  const PaymentFailure({required super.message});
}
class ValidationFailure extends Failure {
  const ValidationFailure({required super.message});
}
class UnexpectedFailure extends Failure {
  const UnexpectedFailure({required super.message});
}
```

