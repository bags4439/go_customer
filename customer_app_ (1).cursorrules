  shipping/       # Shipping tracker
  clearance/      # Clearance choice + self-clearance checklist
  repairs/        # Repair choice + status screens
  documents/      # Per-order document vault
  notifications/  # Global notifications centre
  profile/        # Account settings, ID verification
```

