## RIVERPOD PROVIDERS (Presentation Layer)

```dart
// shared/providers/firebase_providers.dart
@riverpod
FirebaseFirestore firestore(FirestoreRef ref) => FirebaseFirestore.instance;

@riverpod
FirebaseAuth firebaseAuth(FirebaseAuthRef ref) => FirebaseAuth.instance;

@riverpod
FirebaseStorage storage(StorageRef ref) => FirebaseStorage.instance;

// Data source → Repository → Use case → Presentation chain
@riverpod
OrderFirestoreDataSource orderDataSource(OrderDataSourceRef ref) =>
    OrderFirestoreDataSource(ref.watch(firestoreProvider));

@riverpod
OrderRepository orderRepository(OrderRepositoryRef ref) =>
    OrderRepositoryImpl(ref.watch(orderDataSourceProvider));

@riverpod
GetActiveOrdersUseCase getActiveOrdersUseCase(GetActiveOrdersUseCaseRef ref) =>
    GetActiveOrdersUseCase(ref.watch(orderRepositoryProvider));

@riverpod
Stream<Either<Failure, List<Order>>> buyerOrders(BuyerOrdersRef ref) {
  final currentUser = ref.watch(currentUserProvider).value;
  if (currentUser == null) {
    return Stream.value(Left(AuthFailure(message: 'Not authenticated')));
  }
  return ref.watch(getActiveOrdersUseCaseProvider).call(currentUser.id);
}

@riverpod
class PreferenceFormNotifier extends _$PreferenceFormNotifier {
  @override
  PreferenceFormState build() => PreferenceFormState.initial();

  void updateMake(String make) => state = state.copyWith(make: make);
  void updateCondition(VehicleCondition condition) =>
      state = state.copyWith(condition: condition);
}
```

